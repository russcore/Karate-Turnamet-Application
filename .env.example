# Copy this file to server/.env (or repo-root .env) and adjust as needed.
# The SQLite path is relative to server/prisma/schema.prisma, so ../../data points at the repo root.
DATABASE_URL="file:../../data/karate.sqlite"

# HTTP port the backend listens on (also serves the built client in production).
PORT=4000

# Secret used to sign JWT session cookies. CHANGE THIS on a real deployment.
JWT_SECRET="change-me-in-production-please-32chars-min"

# Where uploaded logos / tatami illustrations are written (relative to the server working dir).
UPLOAD_DIR="../uploads"

# Set to "production" when running the built app.
NODE_ENV="development"
